# ---------------------------------------------------------------------------
# SilarAI landing website — static build environment
# ---------------------------------------------------------------------------

# Web3Forms access key for the "Book a Demo" form.
# NOT a secret: it is an alias for the destination inbox, safe in client code.
# Get one at https://web3forms.com using the address that should receive demo
# requests, then restrict it to your domain in the Web3Forms dashboard.
VITE_WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"

# Canonical public origin, used at build time to generate sitemap.xml,
# llms.txt and the /ai/*.json discovery files. Defaults to https://silarai.com
SITE_URL="https://silarai.com"

# ---------------------------------------------------------------------------
# Dormant — WordPress headless CMS
# ---------------------------------------------------------------------------
# src/lib/wordpress.ts and WordPressIntegrationManager.ts are retained but
# inactive: they call a server proxy that no longer exists in the static build.
# See context.md before re-enabling.
# VITE_WORDPRESS_URL="https://your-wordpress-site.com"
